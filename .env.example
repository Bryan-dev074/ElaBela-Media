# Este archivo es una plantilla. Copiar a .env SOLO en la PC. Nunca poner claves en Vercel.
# El flujo predeterminado prepara imágenes para generarlas en el chat de Codex.
ELABELA_GENERATION_PROVIDER=codex-chat
# Solo se usa con proveedores API seleccionados explícitamente.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_SEARCH_MODEL=gpt-6-astra
OPENAI_COPY_MODEL=gpt-6-astra

# La investigación usa la sesión de Codex de esta PC. No necesita OPENAI_API_KEY.
ELABELA_RESEARCH_PROVIDER=codex
# Opcional si codex no está en PATH. Ruta del ejecutable, sin argumentos.
ELABELA_CODEX_PATH=

# La contraseña/token de Meta ya está cifrada con DPAPI en esta carpeta externa.
META_BUSINESS_DIR=D:\ElaBela\MetaBusiness
META_PAGE_ID=TU_PAGE_ID
META_INSTAGRAM_BUSINESS_ID=TU_INSTAGRAM_BUSINESS_ID

# Opcional, una vez importado el repo en Vercel. Origen exacto, sin barra final.
ELABELA_WEB_URL=
